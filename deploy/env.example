# Copier en /home/yt2mp3/env. Lu par systemd : pas de guillemets, pas d'expansion shell.

HOST=127.0.0.1
PORT=3000

# Obligatoire derrière Nginx : sinon le rate limit compte tout le trafic sur une seule IP.
TRUST_PROXY=1

STORAGE_PATH=/home/yt2mp3/data/files
YTDLP_PATH=/usr/local/bin/yt-dlp
FFMPEG_PATH=/usr/bin/ffmpeg

# Un job sature un cœur. Rester sous le nombre de vCPU.
MAX_CONCURRENT_JOBS=2
